# Скопируйте в .env.local и подставьте значения из Firebase console.
# Для эмулятора значения могут быть любыми непустыми, кроме VITE_USE_EMULATOR.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=live-ctf-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=live-ctf-demo
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATOR=true
